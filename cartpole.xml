
<mujoco model="cartpole">
    <compiler angle="radian"/>

    <option
        timestep="0.01"
        gravity="0 0 -9.81"
        integrator="RK4"
    />

    <visual>
        <global offwidth="1280" offheight="720"/>
    </visual>

    <worldbody>
        <light
            pos="0 -3 5"
            dir="0 0 -1"
            diffuse="0.9 0.9 0.9"
        />

        <geom
            name="floor"
            type="plane"
            size="5 5 0.1"
            rgba="0.18 0.20 0.25 1"
        />

        <body name="cart" pos="0 0 0.3">
            <joint
                name="cart_slide"
                type="slide"
                axis="1 0 0"
                range="-2.4 2.4"
                limited="true"
                damping="0.1"
            />

            <geom
                name="cart_geom"
                type="box"
                size="0.2 0.15 0.1"
                mass="1.0"
                rgba="0.2 0.5 0.9 1"
            />

            <body name="pole" pos="0 0 0.1">
                <joint
                    name="pole_hinge"
                    type="hinge"
                    axis="0 1 0"
                    damping="0.01"
                />

                <geom
                    name="pole_geom"
                    type="capsule"
                    fromto="0 0 0 0 0 1"
                    size="0.035"
                    mass="0.2"
                    rgba="0.95 0.35 0.2 1"
                />
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor
            name="cart_motor"
            joint="cart_slide"
            gear="1"
            ctrllimited="true"
            ctrlrange="-100 100"
        />
    </actuator>
</mujoco>

