<mujoco model="double pendulum">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>
  <worldbody>
    <body name="upper" pos="0 0 0">
      <joint name="shoulder" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.8" size="0.035" mass="1"/>
      <body name="lower" pos="0 0 -0.8">
        <joint name="elbow" type="hinge" axis="0 1 0" damping="0.025"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.65" size="0.035" mass="0.7"/>
        <site name="tip" pos="0 0 -0.65" size="0.045"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder drive" joint="shoulder" ctrlrange="-6 6"/>
    <motor name="elbow drive" joint="elbow" ctrlrange="-4 4"/>
  </actuator>
  <keyframe><key name="release" qpos="0.48 -0.13" qvel="-0.2 0.05" ctrl="0.24 -0.11"/></keyframe>
</mujoco>

